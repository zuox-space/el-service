# Скопируйте в deploy/env.production и заполните.
# Пароли со спецсимволами в DATABASE_URL кодируйте через URL-encode.

# --- приложение -------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
NEXTAUTH_URL=https://school.example.ru
NEXTAUTH_SECRET=сгенерируйте_командой_openssl_rand_-base64_32

# --- вход через Яндекс ------------------------------------------------------
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- АИС: MySQL со списком учеников ----------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- запуск -----------------------------------------------------------------
# Наружный порт контейнера (старый билд слушает 3000 — оставляем его)
APP_PORT=3000

# Дождаться базы перед стартом
WAIT_FOR_DB=true

# Применять схему при старте контейнера (для одноразового деплоя).
# После успешного деплоя можно выключить и делать миграции отдельно:
#   docker compose --profile setup run --rm migrate
RUN_MIGRATIONS=true

# Нормализовать классы при старте (только для первого запуска, потом false)
RUN_NORMALIZE=false

# В продакшене НЕ включать:
# DEV_LOGIN=true
