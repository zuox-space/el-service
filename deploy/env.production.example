# Скопируйте в deploy/env.production и заполните.
# Пароли со спецсимволами в DATABASE_URL кодируйте через URL-encode.

# --- приложение -------------------------------------------------------------
# Для 200–300 параллельных запросов ограничьте пул Prisma, например:
# ...?schema=public&connection_limit=15&pool_timeout=20
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
NEXTAUTH_URL=https://school.example.ru
NEXTAUTH_SECRET=сгенерируйте_командой_openssl_rand_-base64_32

# Рейтинг сотрудника и классного руководителя (в разработке)
SHOW_RAITING=false

# --- вход через Яндекс ------------------------------------------------------
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- АИС: MySQL со списком учеников ----------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Пул к внешней АИС: ограничен, чтобы 200–300 запросов не открывали
# сотни соединений. При нехватке увеличьте до 20–30.
DB_POOL_SIZE=15
DB_QUEUE_LIMIT=200

# --- планшет охраны (свой вход, без Яндекса) --------------------------------
GUARD_LOGIN=guard-tablet
GUARD_PASSWORD=сложный_пароль_для_планшета
GUARD_EMAIL=guard-tablet@school.local
GUARD_SESSION_SECRET=отдельная_длинная_случайная_строка

# --- запуск -----------------------------------------------------------------
# Наружный порт контейнера (старый билд слушает 3000 — оставляем его)
APP_PORT=3000

# Дождаться базы перед стартом
WAIT_FOR_DB=true

# Применять схему при старте контейнера (для одноразового деплоя).
# После успешного деплоя можно выключить и делать миграции отдельно:
#   docker compose --profile setup run --rm migrate
RUN_MIGRATIONS=true

# Нормализовать классы при старте (только для первого запуска, потом false)
RUN_NORMALIZE=false

# В продакшене НЕ включать:
# DEV_LOGIN=true
