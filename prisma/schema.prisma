generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"          // меняем с "sqlite"
  url      = env("DATABASE_URL")   // используем переменную из .env
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Индивидуальная настройка доступов: false — доступы считаются по ролям,
  // true — действует только то, что явно отмечено в SectionAccess.
  accessOverride Boolean @default(false)

  // Синхронизация с АИС (portal workers). externalId — стабильный Id записи,
  // syncEnabled — участвует ли сотрудник в синхронизации (у созданных вручную false).
  externalId  String?   @unique
  syncEnabled Boolean   @default(false)

  // Уволенные не удаляются: аккаунт архивируется, история остаётся
  archived   Boolean   @default(false)
  archivedAt DateTime?

  // Обратные связи
  ownedClasses  Class[]         @relation("Owner")
  classShares   ClassShare[]    // Классы, которыми поделились с пользователем
  userRoles     UserRole[]
  sectionAccess SectionAccess[] // Доступы к разделам данных

  // Ключница: пользователи остаются нашими, связи только добавляются
  keyHoldings         KeyItem[]       @relation("KeyHolder")
  keyPermissions      KeyPermission[]
  keyFavorites        KeyFavorite[]
  keyRequestsMade     KeyRequest[]    @relation("KeyRequestsMade")
  keyRequestsReceived KeyRequest[]    @relation("KeyRequestsReceived")
  keyRequestsDecided  KeyRequest[]    @relation("KeyRequestsDecided")
  keyActivity         KeyActivity[]
}

/// Доступ сотрудника к разделу данных.
/// Раздел — единица доступа (нарушения, портфолио, ВШУ, аналитика…). Перечень
/// разделов живёт в коде (lib/access/registry.ts), поэтому новая функция
/// добавляется одним объектом в реестре — без миграции схемы.
model SectionAccess {
  id         String   @id @default(cuid())
  userId     String
  section    String
  allowed    Boolean  @default(true)
  assignedBy String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  /// Доступы по умолчанию: разделы, которые видит сотрудник с этой ролью.
  /// Пустой массив — берутся значения из реестра (lib/access/registry.ts),
  /// чтобы встроенные роли работали без настройки.
  defaultSections String[] @default([])

  userRoles UserRole[]
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     Int
  letter    String
  ownerId   String?
  /// Здание, в котором учится класс — для фильтров пропусков и самовыходов
  buildingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User? @relation("Owner", fields: [ownerId], references: [id])
  building KeyBuilding? @relation("BuildingClasses", fields: [buildingId], references: [id], onDelete: SetNull)

  /// Имя класса — каноническое («5А»); дубли недопустимы
  @@unique([name])
  @@index([buildingId])
  
  // Обратная связь для шарингов
  sharedWith ClassShare[]
}

model ClassShare {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@unique([classId, teacherId])
}

model Pass {
  id        String   @id @default(cuid())
  date      DateTime
  classId   String
  teacherId String
  students  String
  exitTime  String
  used      Boolean  @default(false)  // Отметка о выходе
  usedAt    DateTime?                  // Время выхода
  reason    String
  createdAt DateTime @default(now())
}

model Attendance {
  id              String   @id @default(cuid())
  date            DateTime
  classId         String
  teacherId       String
  presentStudents String
  absentStudents  String
  absentReasons   String
  createdAt       DateTime @default(now())
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  date      DateTime
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  content   String
  completed Boolean  @default(false)
  date      DateTime
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SelfExit {
  id          String   @id @default(cuid())
  studentId   String
  studentName String
  startDate   DateTime
  endDate     DateTime
  photoUrl    String
  reason      String?
  classId     String
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model UnauthorizedLeave {
  id          String   @id @default(cuid())
  studentId   String
  studentName String
  className   String
  leaveTime   DateTime
  returnTime  DateTime?
  reason      String?
  status      String   @default("active")
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Violation {
  id          String   @id @default(cuid())
  studentId   String
  studentName String
  className   String
  violationType String  // тип нарушения
  comment     String?   // комментарий того, кто зафиксировал
  teacherId   String    // кто зафиксировал (сотрудник)
  teacherName String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Отработка нарушения администрацией (в будущем — соцпедагогом)
  resolvedAt        DateTime?
  resolvedBy        String?   // id сотрудника, отметившего отработку
  resolvedByName    String?   // имя для отображения
  resolutionComment String?   // что именно сделано
  resolvedSource    String?   // CLASS_TEACHER — отметил классный руководитель, null — администрация
}
model SchoolRecord {
  id               String    @id @default(cuid())
  studentId        String
  studentName      String
  className        String
  
  // Постановка на учёт
  registeredAt     DateTime
  registeredBy     String
  registeredByName String
  reason           String
  
  // 🔥 Предполагаемый период
  plannedReleaseAt DateTime?  // дата, когда планируется снять с учёта
  
  // Снятие с учёта
  releasedAt       DateTime?
  releasedBy       String?
  releasedByName   String?
  releaseReason    String?
  
  // Статус
  isActive         Boolean   @default(true)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}


model Authorization {
  id              String    @id @default(cuid())
  
  // Ребёнок
  studentId       String
  studentName     String
  className       String
  
  // Доверенное лицо
  trustedName     String    // ФИО того, кто забирает
  relation        String    // Кем приходится ребёнку
  phone           String?   // Телефон (опционально)
  comment         String?   // Комментарий
  
  // Классный руководитель
  teacherId       String
  teacherName     String
  
  // Статус
  isActive        Boolean   @default(true)  // true = активная, false = архив
  revokedAt       DateTime?                 // Когда отозвана
  revokedBy       String?                   // Кто отозвал
  revokedByName   String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================================
// КЛЮЧНИЦА
//
// Отдельная предметная область, перенесённая из keys-app. Пользователи —
// наши (User.id — строка), своей авторизации у ключей нет. Все таблицы новые,
// существующие данные не затрагиваются.
// ============================================================================

enum KeyStatus {
  FREE
  ISSUED
}

enum KeyAccessScope {
  ALL
  RESTRICTED
}

enum KeyRequestType {
  ISSUE
  RETURN
  TRANSFER
}

enum KeyRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model KeyBuilding {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keys    KeyItem[]
  classes Class[]   @relation("BuildingClasses")
}

model KeyItem {
  id          String         @id @default(cuid())
  buildingId  String
  roomNumber  String
  roomName    String         @default("")
  floor       Int            @default(1)
  status      KeyStatus      @default(FREE)
  holderId    String?
  issuedAt    DateTime?
  accessScope KeyAccessScope @default(ALL)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  building    KeyBuilding     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  holder      User?           @relation("KeyHolder", fields: [holderId], references: [id], onDelete: SetNull)
  permissions KeyPermission[]
  favorites   KeyFavorite[]
  requests    KeyRequestItem[]
  activity    KeyActivity[]

  @@unique([buildingId, roomNumber])
  @@index([holderId])
  @@index([status])
}

model KeyPermission {
  userId String
  keyId  String

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key  KeyItem @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([userId, keyId])
  @@index([keyId])
}

model KeyFavorite {
  userId    String
  keyId     String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key  KeyItem @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([userId, keyId])
}

model KeyRequest {
  id           String           @id @default(cuid())
  type         KeyRequestType
  status       KeyRequestStatus @default(PENDING)
  requestedById String
  targetUserId String?
  decidedById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  /// Заявка живёт 1 минуту: если решения нет — автоматически отменяется
  expiresAt    DateTime?

  requester  User             @relation("KeyRequestsMade", fields: [requestedById], references: [id], onDelete: Cascade)
  targetUser User?            @relation("KeyRequestsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  decider    User?            @relation("KeyRequestsDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  keys       KeyRequestItem[]
  activity   KeyActivity[]

  @@index([status])
  @@index([requestedById])
  @@index([targetUserId])
}

model KeyRequestItem {
  requestId String
  keyId     String

  request KeyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  key     KeyItem    @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([requestId, keyId])
  @@index([keyId])
}

model KeyActivity {
  id        String   @id @default(cuid())
  keyId     String?
  requestId String?
  actorId   String?
  action    String
  details   String
  createdAt DateTime @default(now())

  key     KeyItem?    @relation(fields: [keyId], references: [id], onDelete: SetNull)
  request KeyRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([keyId])
  @@index([requestId])
  @@index([createdAt])
}
